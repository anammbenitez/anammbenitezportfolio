---
import HeroName from '../components/HeroName';
import LangSwitch from '../components/LangSwitch';
import Marquee from '../components/Marquee.astro';
import { t, stack, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = t(lang);
---
<header class="relative flex min-h-screen flex-col bg-acid text-ink">
  <div class="section-pad flex items-center justify-between pt-5">
    <span class="label">{c.location}</span>
    <LangSwitch client:load current={lang} label={c.switchLabel} />
  </div>

  <div class="section-pad relative flex flex-1 flex-col justify-center py-10">
    <HeroName client:load lines={['Ana María', 'Marrero', 'Benítez']} />
    <p class="mt-6 max-w-xl font-serif text-2xl italic sm:text-3xl">{c.role} — {c.lead}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="#projects" class="border-2 border-ink bg-ink px-6 py-3 font-mono text-sm uppercase text-acid transition hover:-translate-y-1 hover:bg-hot hover:text-ink">{c.cta} ↓</a>
      <a href="#contact" class="border-2 border-ink px-6 py-3 font-mono text-sm uppercase transition hover:-translate-y-1 hover:bg-ink hover:text-acid">{c.ctaContact}</a>
      <span class="label -rotate-3 border-2 border-ink bg-paper px-3 py-1.5">{c.badge}</span>
    </div>
  </div>

  <Marquee items={stack} />
</header>

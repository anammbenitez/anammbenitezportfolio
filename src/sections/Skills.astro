---
import SkillGrid from '../components/SkillGrid';
import { c } from '../i18n/content';
import type { Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const s = c(lang).skills;
---
<section id="skills" class="section-pad bg-volt py-24 text-paper">
  <p class="label mb-8 text-acid">{s.label}</p>
  <h2 class="mb-14 font-serif text-6xl leading-[0.95] sm:text-8xl">{s.title}</h2>
  <SkillGrid client:visible items={s.items} hint={s.hint} />
</section>

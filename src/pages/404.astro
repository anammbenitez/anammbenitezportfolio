---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · Ana María Marrero Benítez</title>
  </head>
  <body class="bg-acid text-ink antialiased">
    <main class="section-pad grid min-h-screen content-center gap-6 py-16">
      <h1 class="font-display text-[clamp(3rem,16vw,12rem)] font-extrabold uppercase leading-[0.85] tracking-tight">Página no encontrada</h1>
      <p class="max-w-xl font-serif text-2xl italic">Page not found.</p>
      <p class="flex flex-wrap gap-4">
        <a href="/es/" class="border-2 border-ink bg-ink px-6 py-3 font-mono text-sm uppercase text-acid">Inicio</a>
        <a href="/en/" class="border-2 border-ink px-6 py-3 font-mono text-sm uppercase">Home</a>
      </p>
    </main>
  </body>
</html>
